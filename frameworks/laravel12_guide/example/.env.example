APP_NAME="Laravel 12 Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/database.sqlite

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- configuração personalizada do exemplo (lida por config/site.php) ---
SITE_NAME="Dossiê Laravel 12"
SITE_TAGLINE="Notas densas sobre o framework"
SITE_POSTS_PER_PAGE=10
SITE_GITHUB=https://github.com/laravel/laravel

# --- proxy atrás de load balancer (ver 11-proxy.md) ---
# TRUSTED_PROXIES=10.0.0.0/8,192.168.1.1
TRUSTED_HOSTS=localhost
