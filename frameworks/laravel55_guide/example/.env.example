APP_NAME=Laravel55Demo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --- Configuração personalizada (config/site.php) ---
SITE_NAME="Laravel 5.5 Demo"
SITE_OWNER="ACME Ltda"
SITE_POSTS_PER_PAGE=10
SITE_MAINTENANCE_MESSAGE="Voltamos em breve."
SITE_GITHUB_URL=https://github.com/example
SITE_TWITTER_URL=https://twitter.com/example

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

# --- Proxy / Load Balancer (ver example/app/Http/Middleware/TrustProxies.php) ---
# TRUSTED_PROXIES="192.168.1.1,10.0.0.0/8"
